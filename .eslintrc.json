{
  "env": {
    "browser": true,
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "off"
  },
  "globals": {
    "CodeMirror": "readonly",
    "Terminal": "readonly",
    "FitAddon": "readonly",
    "WebLinksAddon": "readonly"
  }
}
