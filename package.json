{
  "name": "ghost-ide",
  "version": "0.1.0",
  "description": "Ghost Embedded Edge AI Language - Integrated Development Environment",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "lint": "eslint src/",
    "test": "jest"
  },
  "keywords": [
    "ghost",
    "embedded",
    "ai",
    "ide",
    "electron",
    "microcontroller"
  ],
  "author": "Cyborg <cyborg@ghost-lang.dev>",
  "license": "MIT",
  "dependencies": {
    "electron-store": "^8.1.0",
    "codemirror": "^5.65.15",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "split.js": "^1.6.5",
    "ws": "^8.14.0",
    "serialport": "^12.0.0",
    "@serialport/parser-readline": "^12.0.0",
    "yaml": "^2.3.0",
    "fs-extra": "^11.1.0",
    "glob": "^10.3.0",
    "chokidar": "^3.5.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "dev.ghost-lang.ide",
    "productName": "Ghost IDE",
    "copyright": "Copyright © 2026 Cyborg",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Development",
      "icon": "resources/icons/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}